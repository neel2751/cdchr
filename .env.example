# Copy to .env and fill in real values. Do NOT commit .env (it is git-ignored).

# --- Auth (Auth.js v5) ---
# Long random string used to sign/encrypt session JWTs. AUTH_SECRET is the v5
# name; NEXTAUTH_SECRET is still read as a fallback.
AUTH_SECRET=
NEXTAUTH_SECRET=
#
# IMPORTANT for multi-tenancy: leave AUTH_URL and NEXTAUTH_URL UNSET.
# If either is set, Auth.js pins every callback and redirect URL to that single
# host, and `trustHost` never takes effect — so every tenant domain but one gets
# sent to the wrong place after signing in. Unset, the URL is derived per
# request from X-Forwarded-Host / Host.
# AUTH_URL=
# NEXTAUTH_URL=
NEXT_PUBLIC_WEB_URL=    # public site URL

# --- Encryption (REQUIRED) ---
# 32-byte key as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# There is no in-code fallback; encryption will fail if this is missing/invalid.
# Server-only key (email/SMTP credential encryption).
EMAIL_ENCRYPTION_KEY=
# Key used by lib/algo.js, which also runs in client components to obfuscate
# record IDs in URLs. Being NEXT_PUBLIC_, it is inlined into the browser bundle,
# so it is NOT a true secret — keep it equal to EMAIL_ENCRYPTION_KEY for now so
# values round-trip between client and server. (See report §4.5 / roadmap.)
NEXT_PUBLIC_ALGO_KEY=

# --- Multi-tenancy ---
# Tenant query scoping (lib/tenantPlugin.js).
#   shadow  (default) nothing is filtered; queries that would fail under
#           enforcement are logged with a stack trace. Leave it here until the
#           "[tenant-shadow]" lines stop appearing in production logs.
#   enforce filters are injected and a query with no tenant throws.
# Do NOT set this to enforce before scripts/backfill-tenant.mjs has run —
# documents without a tenantId become invisible.
TENANT_ENFORCEMENT=shadow

# What happens when one email matches more than one account — which normally
# means the same person was created in two companies, because the app has no
# concept of a branch (see BRANCHES_PLAN.md).
#   warn  (default) sign in as the first match, deterministically, and record
#         the duplicate to the audit log. Nobody is locked out.
#   block refuse the login and tell them to contact an administrator.
# Run `npm run audit:duplicate-emails` first. Once it reports nothing, set this
# to block so a new duplicate cannot quietly reappear.
DUPLICATE_LOGIN_POLICY=warn

# Host that serves the provider-side platform console (/platform). When set,
# /platform is reachable ONLY on this host, and this host serves nothing else.
# Leave empty on a single-domain deployment: /platform then falls back to
# role-only protection (platformAdmin), which is how it behaves today.
PLATFORM_APEX_HOST=          # e.g. app.example.com
# Shared root domain giving every tenant a <slug>.<root> address that keeps
# working while a custom domain's DNS propagates. Leave empty to disable
# subdomain-based tenant resolution.
PLATFORM_ROOT_DOMAIN=        # e.g. example.com
# Where a customer is sent when a module is not included in their plan. Shown on
# the Plan tab of /admin/settings next to each locked module. Leave empty and
# the tab still explains the module is not included — it just offers no link,
# which is better than a mailto: nobody reads.
PLATFORM_SUPPORT_EMAIL=      # e.g. support@example.com

# --- Real-time (Socket.IO) CORS ---
# Comma-separated list of allowed browser origins for socket connections.
# Falls back to NEXTAUTH_URL / NEXT_PUBLIC_WEB_URL if unset.
SOCKET_CORS_ORIGINS=

# --- Database ---
MONGO_DB_URL=
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=

# --- AWS S3 (document storage) ---
AWS_ACCESS_ID=
AWS_ACCESS_PORTAL_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# --- Email (SMTP) ---
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Microsoft 365 / Graph ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=

# --- Web Push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Scheduled jobs ---
# Shared secret required to trigger internal cron endpoints (e.g. visa reminders).
CRON_SECRET=

# --- AI ---
GENAI_API_KEY=

# Seals the AES keys written onto NTAG 424 DNA tags, so a database dump is not
# a box of working hardware. Required before any tag order can be accepted.
#   openssl rand -hex 32
# CHANGING IT ORPHANS EVERY EXISTING TAG KEY — they cannot be re-read, and the
# affected tags have to be re-provisioned.
TAG_KEY_MASTER=
