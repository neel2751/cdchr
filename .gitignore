# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. `.env*` was swallowing it, so the one file that is
# meant to be shared — the documented list of every variable the app needs, all
# values blank — was the one nobody cloning the repo received. Real .env files
# stay ignored by the line above.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Backups written by scripts/migrate-s3-tenant-prefix.mjs --prune-missing.
# They contain production records and must never be committed.
s3-prune-backup-*.json
documents-purge-backup-*.json

# Playwright. Traces and screenshots capture whatever was on screen at the
# moment a test failed, including seeded personal data, so they stay local.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
